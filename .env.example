# Copy to .env and adjust. Every value is validated at startup.
NODE_ENV=development
PORT=3000
# Public origin of the web app (used for CORS / Origin checks / cookies)
APP_ORIGIN=http://localhost:5173
# SQLite file location (directory is created if missing)
DATABASE_PATH=./data/autobattle.db
# Session lifetime in days
SESSION_TTL_DAYS=30
