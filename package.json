{
  "name": "autobattle-online",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run dev -w @autobattle/server & npm run dev -w @autobattle/web",
    "build": "npm run build -w @autobattle/shared && npm run build -w @autobattle/web && npm run build -w @autobattle/server",
    "start": "npm run start -w @autobattle/server",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "balance": "tsx --conditions=development packages/shared/test/sim/report.ts",
    "balance:calibrate": "tsx --conditions=development packages/shared/test/sim/calibrate.ts",
    "balance:history": "tsx --conditions=development packages/shared/test/sim/history.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
